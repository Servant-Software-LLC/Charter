<Project>

  <!-- Repo-wide build policy, inherited by every project (src + tests), mirroring the Guardrails
       house style. Deterministic locked restore (packages.lock.json), analyzer pinning, and the
       CI-only RestoreLockedMode gate are intentionally deferred until Charter's dependency set is
       real and pinned — layer them in here the way Guardrails does at that point. -->
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Pin the SDK code-quality analyzer wave so an SDK roll-forward cannot silently introduce new
         diagnostics that break a previously-green build — which, with TreatWarningsAsErrors above,
         would be a hard failure rather than noise. Keep this in step with the TargetFramework: it
         is a separate knob, so a TFM bump that forgets it leaves the analyzers a wave behind. -->
    <AnalysisLevel>10.0</AnalysisLevel>
  </PropertyGroup>

</Project>
